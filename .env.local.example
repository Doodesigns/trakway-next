# Used by server components when calling the app's internal API.
# For Vercel, set this to the production URL in Project Settings > Environment Variables.
SITE_URL=http://localhost:3000# Base URL used by Server Components when calling this app's own /api/* routes.
# In production, set this to your real domain, e.g. https://myshop.com
# Not required for local dev (defaults to http://localhost:3000).
# Server-only var (no NEXT_PUBLIC_ prefix) since it's never needed on the client.
SITE_URL=http://localhost:3000
